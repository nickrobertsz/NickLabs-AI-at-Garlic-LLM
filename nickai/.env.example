# Optional settings. Copy to .env to use them (the launcher creates .env itself).
NLAG_PORT=8080
# Require this key from every client (dashboard asks once per browser tab). Empty = open to the trusted private networks only.
NLAG_API_KEY=
# Where Ollama keeps its models; filled in by the launcher when it finds them.
OLLAMA_MODELS_DIR=

# Filled in by the launcher on every start:
NLAG_SCAN_NETS=
NLAG_PUBLIC_URL=
NLAG_CAPTURE=1
